# App
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobai?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Observability
LOG_LEVEL=info
SWAGGER_ENABLED=true
